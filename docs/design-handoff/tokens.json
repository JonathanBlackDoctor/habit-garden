{
  "$comment": "습관 정원 현행 디자인 토큰 스냅샷. 원본: apps/web/src/index.css + tailwind.config.js. 개편안은 이 스키마로 design-tokens-v2.json 을 제출한다.",
  "meta": {
    "app": "습관 정원 (Habit Garden)",
    "platform": "mobile-only PWA",
    "locale": "ko-KR",
    "colorScheme": "light-only",
    "shellMaxWidth": 480,
    "designWidth": { "base": 380, "max": 412 }
  },
  "color": {
    "surface": {
      "bg-base":     { "value": "#F4F6EE", "use": "페이지 배경 · PWA theme_color" },
      "bg-surface":  { "value": "#FFFFFF", "use": "카드 · 탭바" }
    },
    "text": {
      "fg-primary":  { "value": "#2A2E27", "use": "본문" },
      "fg-muted":    { "value": "#6B7164", "use": "보조" },
      "fg-faint":    { "value": "#9AA08F", "use": "힌트 · 비활성 (⚠ 대비 검증 필요)" }
    },
    "border": {
      "border":      { "value": "#DDE5D0", "use": "구분선" },
      "border-soft": { "value": "#EAF0E0", "use": "카드 테두리" }
    },
    "semantic": {
      "leaf":        { "value": "#4F7A37", "soft": "#E7F0DD", "use": "주색 · 성장 · 달성 · 활성 탭 · primary 버튼" },
      "bloom":       { "value": "#A85D0B", "soft": "#FAEEDA", "use": "개화 · 포인트(P) · 보상 · 스트릭 · 토스트" },
      "sky":         { "value": "#1F5FA5", "soft": "#E6F1FB", "use": "컨디션 · 물/샘물 · 경건" },
      "soil":        { "value": "#8A6E4B", "use": "흙 · 화단 · 장식" },
      "wither":      { "value": "#C7B68A", "use": "시듦 — 의도적으로 빨강이 아님" }
    },
    "gardenScene": {
      "garden-sky-top":     "#CDEBF6",
      "garden-sky-bottom":  "#EAF6DA",
      "garden-sun":         "#FFF1C2",
      "garden-hill":        "#BFE0A0",
      "garden-soil-top":    "#A98559",
      "garden-soil-bottom": "#7C5C38"
    },
    "$gap": "경고/주의(warning·danger) 의미색이 없다. 그래서 코드 42곳이 Tailwind 기본 red/amber 를 직접 쓴다. v2 에서 정식 토큰으로 추가할 것."
  },
  "typography": {
    "fontFamily": ["Pretendard Variable", "Pretendard", "system-ui", "sans-serif"],
    "fontSource": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9 (외부 CDN — 오프라인 폴백 필요)",
    "baseSize": "15px",
    "weights": [400, 500],
    "numerals": "tabular-nums",
    "scale": null,
    "$gap": "스케일 토큰이 없다. 임의 px 240여 곳(11px 114회, 10px 83회, 9px 5회, 8px 4회). v2 필수 항목."
  },
  "radius": {
    "sm":   "8px",
    "base": "12px",
    "lg":   "16px",
    "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(42,46,39,0.04), 0 2px 5px rgba(42,46,39,0.06)",
    "md": "0 6px 16px -4px rgba(42,46,39,0.12), 0 2px 6px -2px rgba(42,46,39,0.06)"
  },
  "spacing": {
    "scale": "4px 배수 (Tailwind 기본)",
    "mobilePadding": "px-3 py-2",
    "$gap": "간격 토큰이 따로 없다. v2 에서 명시 권장."
  },
  "motion": {
    "easing": { "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)" },
    "duration": { "fast": "140ms", "base": "220ms", "slow": "380ms" },
    "keyframes": {
      "plant-sway":      "7s · 좌우 ±1.3° · 식물 idle",
      "mote-drift":      "9s linear · 먼지 입자",
      "aura-pulse":      "3s · scale 0.96↔1.04 · 후광",
      "halo-rotate":     "회전 · 초월 등급",
      "sparkle-twinkle": "2.4s · 반짝임"
    },
    "press": "active:scale-[0.97]",
    "$gap": "prefers-reduced-motion 대응이 본 앱에 없다(level_desigh 시안에만 존재). v2 필수."
  },
  "layout": {
    "shell": "fixed inset-0 · max-w-[480px] · mx-auto · flex-col",
    "tabBarHeight": "64px + env(safe-area-inset-bottom)",
    "safeArea": {
      "top": "env(safe-area-inset-top)",
      "bottom": "max(env(safe-area-inset-bottom), 8px)"
    },
    "toastOffset": "calc(72px + env(safe-area-inset-bottom))",
    "scrollContainer": "탭 패널 단위 (페이지 전체 아님)",
    "overscroll": "none"
  },
  "components": {
    "card": ".card = radius-base + border-soft + bg-surface + shadow-sm",
    "button": {
      "variants": {
        "default":     "bg-leaf / text-white",
        "secondary":   "bg-leaf-soft / text-leaf",
        "ghost":       "transparent / hover:bg-leaf-soft",
        "outline":     "border-border / transparent",
        "bloom":       "bg-bloom / text-white",
        "destructive": "bg-red-100 / text-red-700  ⚠ 토큰 밖"
      },
      "sizes": { "sm": "h-8 px-3", "default": "h-10 px-4", "lg": "h-12 px-6", "icon": "40x40" },
      "focusRing": "ring-2 ring-leaf ring-offset-2 ring-offset-bg-base"
    },
    "shadcnAvailable": ["button", "tabs", "dialog", "switch", "slider"],
    "radixInstalledButUnwrapped": ["accordion", "label", "select", "separator", "toast", "tooltip"],
    "icons": "lucide-react only"
  }
}
