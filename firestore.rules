rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'XMgQWlM1wtM62hIheTH4sKGDNuC2';
    }
    function isApproved(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/userProfiles/$(uid)).data.status == 'approved';
    }

    match /userProfiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isOwner == false;
      allow update, delete: if isOwner();
    }

    // 본인 데이터는 인증된 사용자(익명 게스트 포함) 누구나 RW.
    // AI·서버 프리미엄 기능은 callable 함수에서 status=='approved' 로 별도 게이트한다.
    match /users/{uid}/{document=**} {
      allow read, write: if (request.auth != null && request.auth.uid == uid) || isOwner();
    }

    // ── 텔레그램 연동 ────────────────────────────────────────────────
    // 연결 정보를 users/{uid} 밑에 두지 않은 이유: 위 users 규칙이 클라이언트 쓰기를
    // 허용하고 Firestore 규칙은 OR 로 평가돼, 하위 경로에서 다시 막을 수 없다.
    // 클라이언트가 이 문서를 쓸 수 있으면 남의 chatId 를 가로채 알림을 빼돌릴 수 있다.
    // 쓰기는 Cloud Functions(Admin SDK, 규칙 우회) 전용.

    // 앱이 연결 상태를 보여주려고 자기 문서만 읽는다.
    match /telegramUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // chatId → uid 역인덱스, 1회용 연결 코드 — 클라이언트는 읽지도 쓰지도 않는다.
    match /telegramLinks/{chatId}   { allow read, write: if false; }
    match /telegramLinkCodes/{code} { allow read, write: if false; }

    // 관리자 문의(버그·문의). 작성자 본인과 owner만 읽고, 생성은 본인,
    // 답변(수정)·삭제는 owner만 가능. 게스트(익명) 포함 인증 사용자면 작성할 수 있다.
    match /inquiries/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isOwner());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isOwner();
    }
  }
}
